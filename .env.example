# Data Quality Copilot - example environment file.
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit a real API key or database password.

# ---------------------------------------------------------------- application
APP_ENV=local
LOG_LEVEL=INFO
# Emit JSON log lines instead of human-readable text (recommended in Docker).
LOG_JSON=false

# ---------------------------------------------------------------- ingestion limits
# Keep STREAMLIT_SERVER_MAX_UPLOAD_SIZE and .streamlit/config.toml in sync with this.
MAX_UPLOAD_MB=25
MAX_ROWS=200000
MAX_COLUMNS=500
PREVIEW_ROWS=50

# ---------------------------------------------------------------- database
# Local development (no database server needed):
DATABASE_URL=sqlite+pysqlite:///./dqcopilot.db
# Docker Compose sets this instead:
# DATABASE_URL=postgresql+psycopg://dqcopilot:dqcopilot@db:5432/dqcopilot

# Set false to run with no database at all. Analysis, corrections and exports still
# work; only the stored audit trail is skipped.
PERSISTENCE_ENABLED=true

# When false (the default), example cell values are stripped from findings before they
# are written to the database, so the audit trail records how many problems there were
# without recording the data itself.
PERSIST_EXAMPLES=false

# Compose credentials (used by docker-compose.yml only).
POSTGRES_USER=dqcopilot
POSTGRES_PASSWORD=change-me-in-real-deployments
POSTGRES_DB=dqcopilot
APP_PORT=8501

# ---------------------------------------------------------------- business rules
RULES_FILE=config/business_rules.yaml

# ---------------------------------------------------------------- AI (optional)
# Leave empty to run in reduced mode: every deterministic check still works and only
# the AI suggestion panel is switched off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Cost and privacy controls for the AI calls.
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_SECONDS=45
AI_SAMPLE_ROWS=5
AI_MAX_COLUMNS=40
# Set false to send only counts and inferred types - no cell values, masked or otherwise.
AI_SEND_SAMPLES=true
